    "TOKENOMICS_CCUSAGE_BIN": "node",
    "TMPDIR": "stage-tmp"
   },
   "at": "2026-10-01T10:31:00Z",
   "run": "hooks/telemetry-capture.mjs",
   "args": [
    "--dispatch"
   ],
   "captureStderr": true
  },
  {
   "stdin": {
    "session_id": "d2"
   },
   "env": {
    "TOKENOMICS_CCUSAGE_BIN": "node",
    "TMPDIR": "stage-tmp"
   },
   "at": "2026-10-01T10:32:00Z",
   "run": "hooks/telemetry-capture.mjs",
