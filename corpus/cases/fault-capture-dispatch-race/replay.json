  "files": {
   "claude": "const fs=require('fs'),p=require('path');const w=(d)=>{for(const e of fs.readdirSync(d,{withFileTypes:true})){const f=p.join(d,e.name);if(e.isDirectory())w(f);else if(f.includes(p.sep+'subagents'+p.sep)&&f.endsWith('.jsonl'))fs.rmSync(f);}};w(p.join(process.env.HOME,'.claude','projects'));process.stdout.write('{\"sessions\":[]}');\n"
  }
 },
 "stores": [
  {
   "from": "inputs/claude/d1.jsonl",
   "to": "home/.claude/projects/{repoKey}/d1.jsonl",
   "mtime": "2026-10-01T10:04:00.000Z",
   "template": true
  },
  {
