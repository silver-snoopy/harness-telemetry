   ".agents/automation/sz/report.json": "{\"batch\":\"sz\",\"cases\":[{\"id\":\"SZ-1\",\"outcome\":\"delivered\"}]}",
   ".agents/automation/hist-open/cost.json": "{\"batch\":\"hist-open\",\"cases\":[{\"id\":\"H1\",\"sizing\":{\"size\":\"M\"},\"direct\":{\"tok\":{\"input\":100,\"output\":1000,\"cacheRead\":0,\"cacheWrite\":0},\"activeMin\":5}}]}",
   ".agents/automation/hist-locked/cost.json": "{\"batch\":\"hist-locked\",\"cases\":[{\"id\":\"H2\",\"sizing\":{\"size\":\"M\"},\"direct\":{\"tok\":{\"input\":100,\"output\":1000,\"cacheRead\":0,\"cacheWrite\":0},\"activeMin\":5}}]}",
   ".agents/estimation/scores.json": "{\"cases\":[{\"id\":\"SZ-1\",\"size\":\"M\",\"sp\":3}]}"
  }
 },
 "stores": [
  {
   "from": "inputs/claude/sz1.jsonl",
   "to": "home/.claude/projects/{repoKey}/sz1.jsonl",
   "mtime": "2026-10-01T10:05:00Z",
   "template": true
  },
  {
   "from": "inputs/claude/w2.jsonl",
   "to": "home/.claude/projects/{repoKey}/w2.jsonl",
   "mtime": "2026-10-01T10:05:00Z",
   "template": true
  }
 ],
 "events": [
  {
   "at": "2026-10-01T10:10:00Z",
   "run": "scripts/work-scope.mjs",
   "args": [
    "open",
    "--session",
    "sz1",
    "--intent",
    "automation",
    "--batch",
    "sz",
    "--cases",
    "SZ-1"
   ],
   "stdin": null,
   "env": {}
  },
  {
   "at": "2026-10-01T10:20:00Z",
   "run": "scripts/work-scope.mjs",
   "args": [
    "close",
    "--session",
    "sz1"
   ],
   "stdin": null,
