card"><h3>Activity</h3><div class="kpi-grid"><div class="stat"><span class="stat-label">Turns</span><span class="stat-value">5</span></div><div class="stat"><span class="stat-label">Tool calls</span><span class="stat-value">11 <span class="stat-sub">(1 err, 91% ok)</span></span></div><div class="stat"><span class="stat-label">Dispatches</span><span class="stat-value">2</span></div><div class="stat"><span class="stat-label">Active time <span class="stat-sub">(session grain — not split per case, stage or dispatch)</span></span><span class="stat-value">0.3h</span></div></div></div></section>
  
  
  
