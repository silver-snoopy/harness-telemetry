an><span class="chip">blocked 1</span><span class="chip">automated 1</span></div></div><div class="kpi-card"><h3>Activity</h3><div class="kpi-grid"><div class="stat"><span class="stat-label">Active</span><span class="stat-value">8.0h <span class="stat-sub">(16.0h wall)</span></span></div><div class="stat"><span class="stat-label">Turns</span><span class="stat-value">80</span></div><div class="stat"><span class="stat-label">Tool calls</span><span class="stat-value">96 <span class="stat-sub">(8 err, 92% ok)</span></span></div><div class="stat"><span class="stat-label">Hosts</span><span class="stat-value">claude 5, copilot-vscode 1, copilot 2</span></div></div></div></section>
